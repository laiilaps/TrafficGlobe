# Kopie nach .env, chmod 600. Wird nie ausgeliefert und enthält keine Geheimnisse, nur Einstellungen.

# Kommagetrennt: Adressen, die nie angezeigt werden sollen (z. B. die eigene Server-IP, wenn ein Monitor sich selbst anpingt).
IGNORE_IPS=

# Besucher (normale Webaufrufe) erst nach dieser Verzögerung in Sekunden anzeigen. 0 = sofort.
PUBLIC_DELAY=900

# Besucher erst anzeigen, wenn in derselben Rasterzelle mindestens so viele waren (k-Anonymität). 1 = jeder einzelne.
PUBLIC_K_MIN=3
